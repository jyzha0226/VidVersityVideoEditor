# Optional local overrides for the subtitle/editor backend.
# Copy these into your shell environment or your own local env setup as needed.

# Python executable used to run the Faster-Whisper and audio activity workers.
# Windows example:
# FASTER_WHISPER_PYTHON=C:\Users\your-name\Desktop\VidVersity\.venv\Scripts\python.exe
# macOS/Linux example:
# FASTER_WHISPER_PYTHON=/Users/your-name/Desktop/VidVersity/.venv/bin/python

# FFmpeg executable path. Leave unset if ffmpeg is already on PATH.
# VIDVERSITY_FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe

# FFprobe executable path. Leave unset if ffprobe is already on PATH.
# VIDVERSITY_FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# Optional backend host/port overrides.
# SUBTITLE_API_HOST=127.0.0.1
# SUBTITLE_API_PORT=8787
